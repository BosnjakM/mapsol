{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    { "src": "^/projekte/gleis$", "status": 308, "headers": { "Location": "/projekte/gleis/" } },
    { "src": "^/termin/?$", "status": 308, "headers": { "Location": "/kontakt" } },
    { "src": "^/projekte/?$", "status": 308, "headers": { "Location": "/services" } },
    { "src": "^/demos?/?$", "status": 308, "headers": { "Location": "/services" } },
    { "handle": "filesystem" },
    { "src": "^/(admin(/.*)?|danke)/?$", "dest": "/index.html" },
    { "src": "^/(.*)$", "status": 404, "dest": "/404.html" }
  ]
}
